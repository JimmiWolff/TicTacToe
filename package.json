{
  "name": "tic-tac-toe-multiplayer",
  "version": "1.0.1",
  "description": "Azure-compatible Multiplayer Tic Tac Toe game with login system",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "echo 'No build step required'",
    "postinstall": "echo 'Installation complete'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:ui": "npx playwright test --ui"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.5.0",
    "@sentry/browser": "^10.20.0",
    "@sentry/node": "^10.20.0",
    "@sentry/profiling-node": "^10.20.0",
    "apple-signin-auth": "^2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.18.2",
    "express-jwt": "^8.5.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.20.0",
    "socket.io": "^4.7.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JimmiWolff/TicTacToe.git"
  },
  "keywords": [
    "tic-tac-toe",
    "multiplayer",
    "websocket",
    "game",
    "azure",
    "nodejs"
  ],
  "author": "JimmiWolff",
  "license": "MIT",
  "homepage": "https://github.com/JimmiWolff/TicTacToe#readme",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "jest": "^30.2.0",
    "snyk": "^1.1302.1",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/e2e/"
    ],
    "collectCoverageFrom": [
      "*.js",
      "!node_modules/**",
      "!coverage/**"
    ]
  }
}
